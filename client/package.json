{
  "name": "ganjacraft-launcher-client",
  "version": "1.0.172",
  "description": "Official Launcher for GanjaCraft Server",
  "main": "src/main.js",
  "scripts": {
    "start": "npm run build:renderer && electron .",
    "dev": "npm run build:renderer:dev && electron .",
    "build:renderer": "node esbuild.config.js",
    "build:renderer:dev": "node esbuild.config.js --dev",
    "watch:renderer": "node esbuild.config.js --watch --dev",
    "build": "npm run build:renderer && electron-builder",
    "release": "npm run build:renderer && node build-release.js"
  },
  "build": {
    "appId": "ru.ganjacraft.launcher",
    "productName": "GanjaCraft Launcher",
    "publish": [
      {
        "provider": "github",
        "owner": "ganjamonsta",
        "repo": "ganjacraft_launcher",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "GanjaCraft_Installer.exe",
      "include": "installer.nsh"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "zip"
      ],
      "maintainer": "GanjaCraft Team <admin@ganj4craft.ru>",
      "icon": "src/assets/icon.png",
      "category": "Game",
      "artifactName": "GanjaCraft_Linux.${ext}"
    }
  },
  "author": "GanjaCraft Team <admin@ganj4craft.ru>",
  "homepage": "https://ganj4craft.ru",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "minecraft-launcher-core": "^3.12.0",
    "ssh2-sftp-client": "^12.1.1"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0"
  }
}