{
  "name": "ganjacraft-launcher-client",
  "version": "1.0.0",
  "description": "Official Launcher for GanjaCraft Server",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "publish-local": "node publish.js"
  },
  "build": {
    "appId": "ru.ganjacraft.launcher",
    "productName": "GanjaCraft Launcher",
    "compression": "maximum",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "src/assets/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/assets/icon.png"
    }
  },
  "author": "GanjaCraft Team",
  "license": "ISC",
  "dependencies": {
    "minecraft-launcher-core": "^3.12.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.0.12"
  }
}
