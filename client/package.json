{
  "name": "ganjacraft-launcher-client",
  "version": "1.0.23",
  "description": "Official Launcher for GanjaCraft Server",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "publish-local": "node publish.js",
    "release": "node build-release.js"
  },
  "build": {
    "appId": "ru.ganjacraft.launcher",
    "productName": "GanjaCraft Launcher",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "src/assets/icon.ico",
      "artifactName": "${productName}.${ext}",
      "publish": [
        {
          "provider": "generic",
          "url": "https://ganjacraft.ru/api/launcher/files/"
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/assets/icon.png"
    }
  },
  "author": "GanjaCraft Team",
  "license": "ISC",
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "minecraft-launcher-core": "^3.12.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.0.12"
  }
}